{
  "name": "@haru/generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
