# Lambda Function URL for the iOS build. Copy to app/mobile/.env (gitignored).
# ios/scripts/inject-api-url.sh copies it into the built Info.plist (HaruApiUrl) at build time.
# The repository root .env (EXPO_PUBLIC_API_URL) is also read if this file is absent.
HARU_API_URL=https://xxxxxxxx.lambda-url.ap-northeast-2.on.aws
